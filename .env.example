# Copy to .env and adjust per environment.
# docker compose interpolates this file automatically.
# go run loads .env if present; real OS env vars win over the file.

# --- App ---
HTTP_ADDR=:8080

# --- Postgres ---
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_SSLMODE=disable
POSTGRES_HOST=localhost

# --- Mongo ---
MONGO_IMAGE=mongo:7
MONGO_PORT=27017
MONGO_HOST=localhost
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DATABASE=products

# --- Kafka ---
KAFKA_IMAGE=confluentinc/cp-kafka:7.6.0
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_CONSUMER_GROUP=product-consumer-group
KAFKA_TOPIC=product-events
